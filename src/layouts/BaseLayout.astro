---
import "../styles/global.css";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternatePath?: string;
}

const { locale, title, description, alternatePath } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://jiashuteng.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const alternateUrl = alternatePath ? new URL(alternatePath, siteUrl) : undefined;
const englishUrl = locale === "en" ? canonicalUrl : alternateUrl;
const chineseUrl = locale === "zh" ? canonicalUrl : alternateUrl;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {chineseUrl && <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />}
    {englishUrl && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
