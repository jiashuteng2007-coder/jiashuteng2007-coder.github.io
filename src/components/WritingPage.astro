---
import type { Locale } from "../data/site";
import { content } from "../data/site";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = content[locale];
const writing = page.writing;
const publishedEntries = (await getCollection("writing"))
  .filter((entry) => entry.data.locale === locale || entry.data.locale === "both")
  .map((entry) => entry.data);
const writingEntries = [...publishedEntries, ...writing.entries]
  .sort((a, b) => b.date.localeCompare(a.date));
const alternatePath = locale === "en" ? "/zh/writing/" : "/writing/";
const title = locale === "en" ? "Writing · Jiashu Teng" : "随笔 · 滕佳树";
const writingBase = locale === "en" ? "/writing" : "/zh/writing";
const dateFormatter = new Intl.DateTimeFormat(locale === "en" ? "en-US" : "zh-CN", {
  year: "numeric",
  month: locale === "en" ? "long" : "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  locale={locale}
  title={title}
  description={writing.introduction}
  alternatePath={alternatePath}
>
  <div class="page-shell writing-shell">
    <SiteHeader content={page} currentPage="writing" alternatePath={alternatePath} />
    <main id="main" class="writing-main">
      <header class="writing-intro">
        <p class="section-label">{locale === "en" ? "Notes & essays" : "札记与随笔"}</p>
        <h1>{writing.title}</h1>
        <p>{writing.introduction}</p>
      </header>

      <section class="writing-list" aria-label={locale === "en" ? "Writing collection" : "随笔列表"}>
        {writingEntries.map((entry, index) => (
          <article class="writing-entry" style={`--entry-index: ${index}`}>
            <div class="writing-image-frame" style={entry.imageBackground ? `background: ${entry.imageBackground}` : undefined}>
              <img
                class:list={{ "writing-image-contain": entry.imageFit === "contain" }}
                style={entry.imagePosition ? `object-position: ${entry.imagePosition}` : undefined}
                src={entry.image}
                alt={entry.imageAlt}
                width="640"
                height="400"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class="writing-entry-copy">
              <time class="writing-entry-date" datetime={entry.date}>
                {dateFormatter.format(new Date(`${entry.date}T00:00:00`))}
              </time>
              <h2>
                <a href={`${writingBase}/${entry.slug}/`}>
                  <span>{entry.title}</span>
                  <span class="writing-link-arrow" aria-hidden="true">↗</span>
                </a>
              </h2>
              <p>{entry.excerpt}</p>
            </div>
          </article>
        ))}
      </section>
    </main>
  </div>
</BaseLayout>
