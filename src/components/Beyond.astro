---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { beyond } = Astro.props.content;
---

<section class="section beyond-section" id="beyond" aria-labelledby="beyond-title">
  <div class="section-heading">
    <h2 id="beyond-title">{beyond.title}</h2>
    <p class="section-introduction">{beyond.introduction}</p>
  </div>
  <div class="beyond-body">
    <div class="interest-list">
      {beyond.interests.map((interest) => (
        <article>
          <div>
            <h3>{interest.name}</h3>
            <p>{interest.detail}</p>
          </div>
        </article>
      ))}
    </div>
    <blockquote class="personal-note">{beyond.note}</blockquote>
  </div>
</section>
