---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
  currentPage?: "home" | "writing";
  alternatePath?: string;
}

const { content, currentPage = "home", alternatePath = content.alternatePath } = Astro.props;
const homePath = content.locale === "en" ? "/" : "/zh/";
const writingPath = content.locale === "en" ? "/writing/" : "/zh/writing/";
---

<a class="skip-link" href="#main">{content.skipLabel}</a>
<header class="site-header">
  <a class="monogram" href={homePath} aria-label="Jiashu Teng home">
    JT<span>.</span>
  </a>
  <nav aria-label={content.locale === "en" ? "Primary navigation" : "主导航"}>
    <a href={homePath} aria-current={currentPage === "home" ? "page" : undefined}>{content.navigation.home}</a>
    <a href={writingPath} aria-current={currentPage === "writing" ? "page" : undefined}>{content.navigation.writing}</a>
    <a class="language-link" href={alternatePath}>{content.alternateLabel}</a>
  </nav>
</header>
