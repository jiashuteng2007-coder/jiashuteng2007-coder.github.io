---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { featured } = Astro.props.content;
---

<section class="section editorial-section" id="featured" aria-labelledby="featured-title">
  <div class="section-heading">
    <h2 id="featured-title">{featured.title}</h2>
  </div>
  <div class="feature-list">
    {featured.articles.map((article) => (
      <article class="feature-card">
        <div class="feature-source">
          <p>{article.source}</p>
        </div>
        <h3>{article.title}</h3>
        <a class="feature-read" href={article.href} target="_blank" rel="noreferrer">
          <strong>{featured.readLabel}</strong><span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
</section>
