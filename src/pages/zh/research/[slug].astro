---
import ResearchArticle from "../../../components/ResearchArticle.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("research"))
    .filter((entry) => entry.data.locale === "zh");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug.replace(/-zh$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ResearchArticle locale="zh" entry={entry} />
